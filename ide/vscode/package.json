{
  "name": "build-ai-context",
  "displayName": "Build AI Context",
  "description": "Export a workspace into AI-readable text bundles without Python.",
  "version": "0.1.0",
  "publisher": "asjnaang",
  "license": "MIT",
  "icon": "media/icon.png",
  "pricing": "Free",
  "homepage": "https://github.com/asjnaang/Build-AI-Context",
  "bugs": {
    "url": "https://github.com/asjnaang/Build-AI-Context/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/asjnaang/Build-AI-Context.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai",
    "context",
    "export",
    "bundle",
    "prompt"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:baic.files",
    "onView:baic.filters",
    "onView:baic.export",
    "onCommand:baic.scan",
    "onCommand:baic.export",
    "onCommand:baic.restore"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Scan and export require a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "baic",
          "title": "AI Context",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "baic": [
        {
          "id": "baic.files",
          "name": "Files"
        },
        {
          "id": "baic.filters",
          "name": "Options"
        },
        {
          "id": "baic.export",
          "name": "Last export"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "baic.files",
        "contents": "Choose files and options, then Export. The catalog loads with the folder.\n[Export](command:baic.export)\n[Restore gzip](command:baic.restore)"
      },
      {
        "view": "baic.filters",
        "contents": "gzip (tar-gz) is the default, matching the CLI. Switch to text for readable bundles.\n[Export](command:baic.export)"
      },
      {
        "view": "baic.export",
        "contents": "Export writes gzip (default) or text bundles plus baic_prompt.md.\n[Export](command:baic.export)\n[Restore gzip export](command:baic.restore)"
      }
    ],
    "commands": [
      {
        "command": "baic.scan",
        "title": "Build AI Context: Refresh catalog",
        "icon": "$(refresh)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "baic.export",
        "title": "Build AI Context: Export",
        "icon": "$(export)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "baic.restore",
        "title": "Build AI Context: Restore gzip export",
        "icon": "$(archive)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "baic.refresh",
        "title": "Build AI Context: Refresh",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "baic.addCurrentFile",
        "title": "Build AI Context: Add Current File"
      },
      {
        "command": "baic.addExplorerPath",
        "title": "Add to AI Context"
      },
      {
        "command": "baic.setKeyword",
        "title": "Build AI Context: Set Keyword"
      },
      {
        "command": "baic.setNameFilter",
        "title": "Build AI Context: Set Filename Filter"
      },
      {
        "command": "baic.setPathFilter",
        "title": "Build AI Context: Set Path Filter"
      },
      {
        "command": "baic.clearFilters",
        "title": "Build AI Context: Clear Filters"
      },
      {
        "command": "baic.selectAllSupported",
        "title": "Build AI Context: Select All Supported"
      },
      {
        "command": "baic.generateFiletree",
        "title": "Build AI Context: Generate Filetree",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "baic.generateGraph",
        "title": "Build AI Context: Generate Code Graph",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "baic.openLastExport",
        "title": "Build AI Context: Open Last Export"
      },
      {
        "command": "baic.openAgentContract",
        "title": "Build AI Context: Open Agent Contract"
      },
      {
        "command": "baic.toggleRedact",
        "title": "Build AI Context: Toggle Redact"
      },
      {
        "command": "baic.toggleSecrets",
        "title": "Build AI Context: Toggle Secrets"
      },
      {
        "command": "baic.toggleOverview",
        "title": "Build AI Context: Toggle Overview"
      },
      {
        "command": "baic.cycleGraph",
        "title": "Build AI Context: Cycle Graph Format"
      },
      {
        "command": "baic.cycleTransport",
        "title": "Build AI Context: Switch gzip/text"
      },
      {
        "command": "baic.toggleForceBundle",
        "title": "Build AI Context: Toggle large files"
      },
      {
        "command": "baic.toggleForceIgnored",
        "title": "Build AI Context: Toggle ignored paths"
      },
      {
        "command": "baic.toggleSplit",
        "title": "Build AI Context: Toggle split gzip"
      },
      {
        "command": "baic.setExcludePaths",
        "title": "Build AI Context: Set excluded paths"
      },
      {
        "command": "baic.setForceIncludeFormats",
        "title": "Build AI Context: Set extra formats"
      },
      {
        "command": "baic.searchFiles",
        "title": "Build AI Context: Search files"
      },
      {
        "command": "baic.chooseFormat",
        "title": "Build AI Context: Filter by file format"
      },
      {
        "command": "baic.selectSearchResults",
        "title": "Build AI Context: Select all results"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "baic.addExplorerPath",
          "group": "baic@1",
          "when": "isWorkspaceTrusted"
        }
      ],
      "editor/context": [
        {
          "command": "baic.addCurrentFile",
          "group": "baic@1",
          "when": "isWorkspaceTrusted"
        }
      ],
      "view/title": [
        {
          "command": "baic.export",
          "when": "isWorkspaceTrusted && view == baic.files",
          "group": "navigation"
        },
        {
          "command": "baic.export",
          "when": "isWorkspaceTrusted && view == baic.filters",
          "group": "navigation"
        },
        {
          "command": "baic.restore",
          "when": "isWorkspaceTrusted && view == baic.files",
          "group": "navigation"
        },
        {
          "command": "baic.restore",
          "when": "isWorkspaceTrusted && view == baic.export",
          "group": "navigation"
        },
        {
          "command": "baic.scan",
          "when": "isWorkspaceTrusted && view == baic.files",
          "group": "navigation"
        },
        {
          "command": "baic.refresh",
          "when": "isWorkspaceTrusted && view == baic.files",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Build AI Context",
      "properties": {
        "baic.maxFileLines": {
          "type": "number",
          "default": 3000
        },
        "baic.outputDir": {
          "type": "string",
          "default": ""
        },
        "baic.redact": {
          "type": "boolean",
          "default": false
        },
        "baic.includeSecretFiles": {
          "type": "boolean",
          "default": false
        },
        "baic.projectOverview": {
          "type": "boolean",
          "default": false
        },
        "baic.writeGraph": {
          "type": "string",
          "enum": [
            "off",
            "txt",
            "json"
          ],
          "default": "off"
        },
        "baic.updateGitignore": {
          "type": "boolean",
          "default": false
        },
        "baic.transport": {
          "type": "string",
          "enum": [
            "tar-gz",
            "text"
          ],
          "default": "tar-gz",
          "description": "gzip (default, baic_prompt_gzip.md) or readable text bundles (baic_prompt_text.md)."
        },
        "baic.forceBundle": {
          "type": "boolean",
          "default": false
        },
        "baic.forceIgnored": {
          "type": "boolean",
          "default": false
        },
        "baic.split": {
          "type": "boolean",
          "default": false,
          "description": "Split gzip payloads to stay under 19.9 MB (CLI --split)."
        },
        "baic.excludePaths": {
          "type": "string",
          "default": "",
          "description": "Comma-separated relative paths to exclude (CLI --exclude-paths)."
        },
        "baic.forceIncludeFormats": {
          "type": "string",
          "default": "",
          "description": "Comma-separated extensions to include in gzip (CLI --force-include-formats)."
        },
        "baic.task": {
          "type": "string",
          "default": "",
          "description": "Replaces the Task placeholder in baic_prompt.md."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "baic.gettingStarted",
        "title": "Build AI Context",
        "description": "Choose files and options, then Export. Restore gzip exports when you need the sources back.",
        "steps": [
          {
            "id": "open",
            "title": "Open AI Context",
            "description": "Open the AI Context view in the Activity Bar.",
            "media": {
              "markdown": "README.md"
            }
          },
          {
            "id": "files",
            "title": "Choose files",
            "description": "The catalog loads with the folder. Uncheck files or set Options (gzip vs text, exclude paths, force-bundle).",
            "media": {
              "markdown": "README.md"
            }
          },
          {
            "id": "filter",
            "title": "Filter",
            "description": "Toggle categories or add the current file.",
            "media": {
              "markdown": "README.md"
            }
          },
          {
            "id": "export",
            "title": "Export",
            "description": "Export bundles and open the Agent Contract.",
            "media": {
              "markdown": "README.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "mkdir -p resources && cp ../policy/policy.json ../engine-ts/baic_prompt_gzip.md ../engine-ts/baic_prompt_text.md resources/ && esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "package": "npm run compile && vsce package",
    "test": "npm run compile && node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
