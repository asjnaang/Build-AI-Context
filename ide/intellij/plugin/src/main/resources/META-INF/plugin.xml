<idea-plugin url="https://github.com/asjnaang/Build-AI-Context">
    <id>com.asjnaang.buildaicontext</id>
    <name>Build AI Context</name>
    <vendor url="https://github.com/asjnaang/Build-AI-Context">ASJN</vendor>
    <description><![CDATA[
      <p>Choose files and options, then Export. Cataloging is automatic. No Python required.</p>
      <p>gzip (tar-gz) is the default, matching the CLI. Export writes bundles, a manifest, and
      <code>baic_prompt.md</code>. Restore unpacks a gzip export.</p>
      <p>Works on IntelliJ IDEA, Android Studio, WebStorm, PyCharm, and other IntelliJ Platform IDEs
      (depends on <code>com.intellij.modules.platform</code> only).</p>
    ]]></description>
    <change-notes><![CDATA[
      <p>0.1.0 — Export-first Host: catalog loads with the project, gzip default, Restore,
      Add to AI Context, Generate Filetree / Code Graph. Secrets require a confirm dialog.</p>
    ]]></change-notes>
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="AI Context"
                    anchor="right"
                    factoryClass="com.asjnaang.buildaicontext.BaicToolWindowFactory"/>
        <applicationConfigurable parentId="tools"
                                 id="com.asjnaang.buildaicontext.settings"
                                 instance="com.asjnaang.buildaicontext.BaicSettingsConfigurable"
                                 displayName="Build AI Context"/>
        <notificationGroup id="Build AI Context" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="com.asjnaang.buildaicontext.Export"
                class="com.asjnaang.buildaicontext.BaicExportAction"
                text="Build AI Context: Export"
                description="Export the current AI Context selection">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.asjnaang.buildaicontext.Restore"
                class="com.asjnaang.buildaicontext.BaicRestoreAction"
                text="Build AI Context: Restore gzip"
                description="Restore sources from a gzip export">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.asjnaang.buildaicontext.Scan"
                class="com.asjnaang.buildaicontext.BaicScanAction"
                text="Build AI Context: Refresh catalog"
                description="Reload the file catalog">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.asjnaang.buildaicontext.Refresh"
                class="com.asjnaang.buildaicontext.BaicRefreshAction"
                text="Refresh"
                description="Rescan the project"/>
        <action id="com.asjnaang.buildaicontext.Clear"
                class="com.asjnaang.buildaicontext.BaicClearAction"
                text="Clear"
                description="Reset filters and default file checks"/>
        <action id="com.asjnaang.buildaicontext.GenerateFiletree"
                class="com.asjnaang.buildaicontext.BaicGenerateFiletreeAction"
                text="Build AI Context: Generate Filetree"
                description="Write a filetree next to the project">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.asjnaang.buildaicontext.GenerateGraph"
                class="com.asjnaang.buildaicontext.BaicGenerateGraphAction"
                text="Build AI Context: Generate Code Graph"
                description="Write a code graph next to the project">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.asjnaang.buildaicontext.AddToContext"
                class="com.asjnaang.buildaicontext.BaicAddToContextAction"
                text="Add to AI Context"
                description="Add the current file or path to the AI Context selection">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
